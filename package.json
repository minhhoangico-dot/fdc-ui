{
  "name": "@fdc/ui",
  "version": "2.1.0",
  "description": "FDC Bác sĩ gia đình — atomic design system (tokens, atoms, molecules, organisms, templates)",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/tokens-from-design.mjs",
    "tokens:check": "node scripts/tokens-from-design.mjs --check",
    "build:design": "vite build -c vite.design.config.ts && node scripts/design-bundle.mjs",
    "review:visual": "npm run build-storybook -- --quiet && node .claude/skills/atomic-design-system/scripts/shots.mjs --storybook storybook-static --themes clinic,nursing-home --out visual-review",
    "lint:tokens": "node .claude/skills/atomic-design-system/scripts/lint-tokens.mjs src/components --strict",
    "lint:levels": "node .claude/skills/atomic-design-system/scripts/lint-levels.mjs src/components",
    "contrast": "node .claude/skills/atomic-design-system/scripts/contrast.mjs --css src/tokens/tokens.css --pairs design/contrast-pairs.json && node .claude/skills/atomic-design-system/scripts/contrast.mjs --css src/tokens/tokens.css --scope \"[data-theme='nursing-home']\" --pairs design/contrast-pairs.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run tokens:check && npm run lint:tokens && npm run lint:levels && npm run contrast",
    "skill:sync": "node scripts/sync-skill.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^0.11.1",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
